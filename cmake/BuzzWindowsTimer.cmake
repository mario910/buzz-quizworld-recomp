option(BUZZ_WINDOWS_TIMER_REUSE "Experimental reusable high-resolution syscall timer" OFF)
if(NOT WIN32 OR NOT BUZZ_WINDOWS_TIMER_REUSE)
    return()
endif()
set(timer_input "${PS3RECOMP_DIR}/runtime/syscalls/sys_timer.c")
file(READ "${timer_input}" timer_text)
string(REPLACE "\r\n" "\n" timer_text "${timer_text}")
set(timer_anchor "    if (usec >= 1000) {\n        HANDLE timer = CreateWaitableTimerW(NULL, TRUE, NULL);")
string(FIND "${timer_text}" "${timer_anchor}" timer_found)
if(timer_found EQUAL -1)
    message(FATAL_ERROR "Timer adapter no longer matches SDK")
endif()
string(REPLACE "${timer_anchor}" "    if (usec >= 1000) {\n        if (buzz_windows_timer_wait(usec)) return CELL_OK;\n        HANDLE timer = CreateWaitableTimerW(NULL, TRUE, NULL);" timer_text "${timer_text}")
set(timer_output "${CMAKE_CURRENT_BINARY_DIR}/buzz_sys_timer.c")
file(CONFIGURE OUTPUT "${timer_output}" CONTENT "#include \"windows_timer_wait.h\"\n${timer_text}" @ONLY)
get_target_property(timer_sources ps3recomp_runtime SOURCES)
list(REMOVE_ITEM timer_sources "${timer_input}")
set_property(TARGET ps3recomp_runtime PROPERTY SOURCES "${timer_sources}")
target_sources(ps3recomp_runtime PRIVATE "${timer_output}")
set_source_files_properties("${timer_output}" TARGET_DIRECTORY ps3recomp_runtime PROPERTIES
    INCLUDE_DIRECTORIES "${PS3RECOMP_DIR}/runtime/syscalls;${CMAKE_CURRENT_SOURCE_DIR}")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${timer_input}")
